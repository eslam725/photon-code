   "source": [
    "import openmc"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "a5fd97f0-6816-4ecf-88d1-d840bd817d40",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Photon source, 1×10⁶ MeV, isotropic point\n",
    "# Rationale: For a monoenergetic source we want a discrete function in energy; isotropic emission from a single point.\n",
    "\n",
    "#particle: "photon", "neutron", etc.
     - space: Spatial object
     - angle: Angular object
     - energy: Energy Distribution\n"
    "photon_source = openmc.IndependentSource()\n",
    "\n",
    "#particle: determine the particle(photon or neytron)\n",
    "photon_source.particle = 'photon'\n",
    "\n",
    "#Spatial distribution: point at the origin\n",
    "photon_source.space = openmc.stats.Point((0.0, 0.0, 0.0))\n",
    "\n",
    "# Angular distribution: isotropic\n",
    "photon_source.angle = openmc.stats.Isotropic()\n",
    "\n",
    "# Energy distribution:  with an energy of 1×10⁶ MeV & a probability of 1\n",
    "photon_source.energy = openmc.stats.Discrete([1.0e12], [1.0])  # 1 × 10^6 MeV photons\n",
    "\n",
    "openmc.settings.source = photon_source"
   ]
  },
  {
